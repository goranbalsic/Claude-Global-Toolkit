# Line endings are a correctness constraint here, not a style preference.
# Without this file a Windows checkout with core.autocrlf=true rewrote shell
# scripts and test fixtures to CRLF, which made 4 tests fail on the primary
# development machine while passing everywhere else. Anything executed by
# sh/POSIX tooling, and every text fixture a hash is compared against, must
# stay LF in the working tree on all platforms.
* text=auto eol=lf

*.sh            text eol=lf
bin/ctk         text eol=lf
tests/run.sh    text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# PowerShell is happy with LF and the repo stays byte-identical across
# platforms, which matters because bootstrap compares file hashes.
*.ps1           text eol=lf

*.png           binary
*.jpg           binary
*.gif           binary
*.keystore      binary
*.jks           binary
